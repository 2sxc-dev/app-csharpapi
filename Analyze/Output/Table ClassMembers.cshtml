@inherits Custom.Hybrid.RazorTyped<AppCode.Razor.DetailsSpecs>
@using AppCode

<table>
  @* Show header row with icons etc. *@
  @Html.Partial("./VisibilityHeader.cshtml")

  @foreach (var member in Model.ClassInfo.Members.Relevant)
  {
    @* Row with selection active *@
    <tr class='@(Model.SelectedMemberName == member.Name ? "selected" : "")'>
      @* Type icon with status tooltip *@
      <td title="@member.TypeInfo.Message">
        @member.TypeInfo.Icon
      </td>

      @* Member label with link to select it *@
      <td title="@member.LabelExtended">
        <a href='@Link.To(parameters: MyPage.Parameters.Toggle("Member", member.Name))'>
          @member.Label
        </a>
      </td>

      @* Visibility info-details for the member *@
      @Html.Partial("./VisibilityColumns.cshtml", new { visibility = member.Visibility })
    </tr>
  }
</table>